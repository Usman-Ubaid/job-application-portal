{
    "services": {
        "web": {
            "root": "frontend/",
            "framework": "nextjs"
        }, 
        "api": {
            "root": "backend/",
             "framework": "django"
        }
    }, 
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "api"
            }
        }, {
            "source": "/(.*)",
            "destination": {
                "service": "web"
            }
        }
    ]
}